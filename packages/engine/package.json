{
  "name": "@sinnect/engine",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "dist/engine.mjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:mock": "SINNECT_MOCK=1 tsx watch src/main.ts",
    "start": "node dist/engine.mjs",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --external:node-pty --outfile=dist/engine.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.317",
    "node-pty": "^1.1.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
